// ---- SETUP ------------------------------------------------

function setup() {
  createCanvas(windowWidth, windowHeight);

  textFont("Courier New");
  textSize(18);
  textAlign(LEFT, BASELINE);

  thresholdSlider = createSlider(
    -80, -10, START_THRESHOLD, 1
  );

  thresholdSlider.style("width", "60vw");

  positionSlider();
  createNewPoemParticles();
}

// ---- DRAW -------------------------------------------------

function draw() {
  const ink = isSound ? 10 : 245;

  background(isSound ? 245 : 20);

  if (!started) {
    fill(ink);
    textAlign(CENTER, CENTER);
    textSize(min(width, height) / 16);

    text(
      "HEAT\n\ntap to start\nthe microphone",
      width / 2,
      height / 2
    );

    return;
  }

  // Audio processing

  level = measureLevel();

  const threshold = thresholdSlider.value();

  if (level > threshold) {
    lastLoudTime = millis();

    if (!isSound) {
      isSound = true;
      soundCount++;
      soundStarted();
    }

  } else if (
    isSound &&
    millis() - lastLoudTime > HOLD_MS
  ) {
    isSound = false;
    soundEnded();
  }

  // Stanza triggers

  for (let s = 0; s < stanzasBounds.length; s++) {
    let b = stanzasBounds[s];

    let hovering =
      mouseX >= b.minX &&
      mouseX <= b.maxX &&
      mouseY >= b.minY &&
      mouseY <= b.maxY;

    if (hovering || isSound) {
      triggeredStanzas[s] = true;
    }
  }

  // Update and display particles

  textAlign(LEFT, BASELINE);

  for (let i = particles.length - 1; i >= 0; i--) {
    let p = particles[i];

    let dissipating =
      triggeredStanzas[p.stanzaIndex] === true;

    p.update(dissipating);
    p.display();

    if (p.alpha <= 0) {
      particles.splice(i, 1);
    }
  }

  // Generate a new poem

  if (particles.length === 0) {
    createNewPoemParticles();
  }

  // Audio visualization

  drawGraph(threshold, ink);

  textStyle(NORMAL);
  textSize(12);
  textAlign(LEFT, TOP);
  fill(ink);

  text(
    `HEAT — GENERATIVE POETRY
level: ${level.toFixed(0)} dB
threshold: ${threshold} dB
sounds heard: ${soundCount}`,
    16,
    16
  );
}

