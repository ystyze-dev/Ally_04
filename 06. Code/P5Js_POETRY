// ---- MICROPHONE -------------------------------------------

async function startMicrophone() {
  try {
    const stream =
      await navigator.mediaDevices.getUserMedia({
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false
        }
      });

    audioContext = new (
      window.AudioContext ||
      window.webkitAudioContext
    )();

    await audioContext.resume();

    const microphone =
      audioContext.createMediaStreamSource(stream);

    analyser = audioContext.createAnalyser();
    analyser.fftSize = 2048;

    microphone.connect(analyser);

    samples = new Float32Array(analyser.fftSize);

    started = true;

  } catch (err) {
    alert(
      "Could not use microphone: " + err.message
    );
  }
}

function measureLevel() {
  if (!analyser || !samples) {
    return -100;
  }

  analyser.getFloatTimeDomainData(samples);

  let sumOfSquares = 0;

  for (let i = 0; i < samples.length; i++) {
    sumOfSquares += samples[i] * samples[i];
  }

  const rms = sqrt(
    sumOfSquares / samples.length
  );

  return 20 * Math.log10(
    max(rms, 0.00001)
  );
}

// ---- PARTICLE CLASS ---------------------------------------

class TextParticle {

  constructor(
    char,
    x,
    y,
    stanzaIndex,
    isSpanish = false
  ) {
    this.char = char;

    this.targetX = x;
    this.targetY = y;

    this.stanzaIndex = stanzaIndex;
    this.isSpanish = isSpanish;

    this.x = x;
    this.y = y;

    this.vx = 0;
    this.vy = 0;

    this.ax = 0;
    this.ay = 0;

    this.alpha = 255;
    this.size = poemFontSize;

    this.noiseOffset = random(1000);

    this.isRed =
      char.toLowerCase() === "e";
  }

  update(isDissipating) {

    if (!isDissipating) {
      this.x = this.targetX;
      this.y = this.targetY;
      return;
    }

    let windX = (
      noise(
        this.noiseOffset +
        frameCount * 0.02
      ) - 0.45
    ) * 0.8;

    let windY = (
      noise(
        this.noiseOffset +
        500 +
        frameCount * 0.02
      ) - 0.65
    ) * 0.5;

    this.ax += windX;
    this.ay += windY;

    this.vx += this.ax;
    this.vy += this.ay;

    this.vx *= 0.92;
    this.vy *= 0.92;

    this.x += this.vx;
    this.y += this.vy;

    // Red letters persist longer

    if (this.isRed) {
      this.alpha -= random(0.8, 1.5);
      this.size = max(
        0,
        this.size - 0.025
      );

    } else {
      this.alpha -= random(1.5, 3.5);
      this.size = max(
        0,
        this.size - 0.08
      );
    }

    this.ax = 0;
    this.ay = 0;

    if (this.size <= 0) {
      this.alpha = 0;
    }
  }

  display() {

    if (this.alpha <= 0) return;

    push();

    noStroke();

    if (this.isRed) {
      fill(255, 50, 50, this.alpha);
    } else {
      fill(
        isSound ? 10 : 240,
        this.alpha
      );
    }

    textFont("Courier New");
    textSize(this.size);

    if (this.isSpanish) {
      textStyle(BOLD);
    } else {
      textStyle(NORMAL);
    }

    text(this.char, this.x, this.y);

    pop();
  }
}

// ---- POEM GENERATOR HELPERS -------------------------------

function getCleanToken(
  arr,
  isSpanish = false
) {
  let rawWord = random(arr);

  // Preserve multiword expressions

  let cleanWord = rawWord
    .trim()
    .replace(/\s+/g, " ");

  return {
    word: cleanWord,
    isSpanish: isSpanish
  };
}

function E(arr) {
  return getCleanToken(arr, false);
}

function S(arr) {
  return getCleanToken(arr, true);
}

function literal(word, isSpanish = false) {
  return {
    word: word,
    isSpanish: isSpanish
  };
}

// ---- TEN RANDOMIZED LINGUISTIC PATTERNS -------------------

function makeLineTokens() {

  let pattern = floor(random(10));

  switch (pattern) {

    // Pattern 0: Embodied heat

    case 0:
      return [
        literal("tu", true),
        S(spanish_presence_being),
        literal("es", true),
        S(spanish_adverb),
        E(english_adjective)
      ];

    // Pattern 1: Mythological heat

    case 1:
      return [
        literal("the"),
        E(english_mythical_beings_creatures_entities),
        literal("of"),
        S(spanish_mythical_places_realms),
        E(english_verb),
        S(spanish_adverb)
      ];

    // Pattern 2: Material transformation

    case 2:
      return [
        literal("a"),
        E(english_adjective),
        E(english_presence_tangible),
        literal("turns"),
        S(abstractconcept_idioms_spanish)
      ];

    // Pattern 3: Exclamation and action

    case 3:
      return [
        S(spanish_interjections_exclamation),
        S(spanish_verb),
        S(spanish_adverb),
        E(latin_idioms)
      ];

    // Pattern 4: Absence and mystical matter

    case 4:
      return [
        literal("sin", true),
        S(spanish_noun),
        S(spanish_preposition_sconnectors),
        S(spanish_mystical_objects_artefacts)
      ];

    // Pattern 5: Mythical beings and sensations

    case 5:
      return [
        S(spanish_mythical_beings_creatures_entities),
        S(spanish_verb),
        literal("with"),
        E(english_adjective),
        S(spanish_presence_tangible)
      ];

    // Pattern 6: Thermal presence

    case 6:
      return [
        literal("el", true),
        S(spanish_adjective),
        S(spanish_presence_being),
        literal("of"),
        E(english_noun)
      ];

    // Pattern 7: Radiance and abstraction

    case 7:
      return [
        E(english_mystical_objects_artefacts),
        literal("brilla", true),
        S(spanish_adverb),
        E(abstractconcept_idioms_english)
      ];

    // Pattern 8: Interior heat

    case 8:
      return [
        E(english_interjectionsexclamation),
        S(spanish_verb),
        E(english_prepositionsconnectors),
        E(english_presence_being),
        E(english_adverb)
      ];

    // Pattern 9: Thermal landscapes

    default:
      return [
        literal("beyond"),
        E(english_mythical_places_realms),
        S(spanish_presence_tangible),
        E(english_verb),
        S(spanish_latin_idioms)
      ];
  }
}

// ---- FOUR-STANZA POEM GENERATOR ---------------------------

function makePoemTokens(numStanzas = 4) {

  let stanzas = [];

  for (let s = 0; s < numStanzas; s++) {

    let linesInStanza = floor(
      random(1, 3)
    );

    let stanzaLines = [];

    for (let l = 0; l < linesInStanza; l++) {
      stanzaLines.push(makeLineTokens());
    }

    stanzas.push(stanzaLines);
  }

  return stanzas;
}

// ---- TYPOGRAPHIC LAYOUT -----------------------------------

function createNewPoemParticles(
  regenerate = true
) {

  particles = [];
  stanzasBounds = [];
  triggeredStanzas = {};

  if (regenerate || currentPoem.length === 0) {
    currentPoem = makePoemTokens(4);
  }

  let stanzas = currentPoem;

  let longestLine = 1;
  let totalLines = 0;

  // Calculate the longest line

  for (let stanza of stanzas) {

    totalLines += stanza.length;

    for (let line of stanza) {

      let length = line
        .map(token => token.word)
        .join(" ")
        .length;

      longestLine = max(
        longestLine,
        length
      );
    }
  }

  // Responsive typography

  let availableWidth = width * 0.88;
  let availableHeight = height * 0.48;

  let horizontalSize =
    availableWidth / (longestLine * 0.61);

  let verticalSize =
    availableHeight /
    (totalLines * 1.9 + 3 * 1.3);

  poemFontSize = max(
    6,
    min(
      18,
      horizontalSize,
      verticalSize
    )
  );

  textFont("Courier New");
  textStyle(NORMAL);
  textSize(poemFontSize);

  let charWidth = textWidth("M");
  let lineHeight = poemFontSize * 1.9;
  let stanzaGap = poemFontSize * 1.3;

  let stanzaWidths = [];
  let totalHeight = 0;

  // Calculate stanza dimensions

  for (let s = 0; s < stanzas.length; s++) {

    let maxWidth = 0;

    for (let line of stanzas[s]) {

      let lineWidth =
        line.map(t => t.word)
          .join(" ")
          .length * charWidth;

      maxWidth = max(
        maxWidth,
        lineWidth
      );
    }

    stanzaWidths.push(maxWidth);

    totalHeight +=
      stanzas[s].length * lineHeight;
  }

  totalHeight +=
    (stanzas.length - 1) * stanzaGap;

  let currentY =
    height * 0.43 -
    totalHeight / 2 +
    poemFontSize;

  // Create individual letter particles

  for (let s = 0; s < stanzas.length; s++) {

    let stanzaW = stanzaWidths[s];
    let startX = (width - stanzaW) / 2;

    let stanzaMinX = startX - 10;
    let stanzaMaxX = startX + stanzaW + 10;

    let stanzaMinY =
      currentY - poemFontSize;

    let stanzaMaxY =
      currentY +
      stanzas[s].length * lineHeight;

    for (let line of stanzas[s]) {

      let currentX = startX;

      for (let token of line) {

        for (let char of token.word) {

          if (char !== " ") {

            particles.push(
              new TextParticle(
                char,
                currentX,
                currentY,
                s,
                token.isSpanish
              )
            );
          }

          currentX += charWidth;
        }

        currentX += charWidth;
      }

      currentY += lineHeight;
    }

    stanzasBounds.push({
      minX: stanzaMinX,
      maxX: stanzaMaxX,
      minY: stanzaMinY,
      maxY: stanzaMaxY
    });

    currentY += stanzaGap;
  }
}

// ---- AUDIO GRAPH ------------------------------------------

function drawGraph(threshold, ink) {

  history.push(level);

  if (history.length > 300) {
    history.shift();
  }

  const top = height * 0.74;
  const bottom = height - 90;

  const y = db =>
    map(db, -90, 0, bottom, top, true);

  // Red threshold line

  stroke(255, 90, 54);
  strokeWeight(2);

  line(
    0,
    y(threshold),
    width,
    y(threshold)
  );

  // Microphone waveform

  stroke(ink);
  strokeWeight(1);
  noFill();

  beginShape();

  history.forEach((db, i) => {
    vertex(
      map(i, 0, 299, 0, width),
      y(db)
    );
  });

  endShape();

  noStroke();
}

